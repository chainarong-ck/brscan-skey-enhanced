# shellcheck shell=bash

scan_script=""
for candidate in \
    /usr/local/lib/brscan-skey-enhanced/script/brother-scan-to-file.sh \
    /usr/lib/brscan-skey-enhanced/script/brother-scan-to-file.sh \
    "$HOME/.brscan-skey/script/brother-scan-to-file.sh"
do
    if [ -x "$candidate" ]; then
        scan_script="$candidate"
        break
    fi
done

if [ -z "$scan_script" ]; then
    logger -t brscan-skey "Brother Scan to File helper was not found"
    exit 1
fi

"$scan_script" "${1:-}"
rc=$?
exit "$rc"
