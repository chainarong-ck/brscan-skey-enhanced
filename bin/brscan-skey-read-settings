#!/bin/sh
set -eu

case "$0" in
    */*) launcher_path="$0" ;;
    *) launcher_path="$(command -v "$0" || true)" ;;
esac
if [ -z "$launcher_path" ]; then
    echo "brscan-skey-read-settings: cannot determine launcher path" >&2
    exit 1
fi
launcher_path="$(readlink -f "$launcher_path")"
install_prefix="$(dirname "$(dirname "$launcher_path")")"
app_dir="$install_prefix/lib/brscan-skey-enhanced"

if [ ! -d "$app_dir/configurator" ]; then
    echo "brscan-skey-read-settings: application files not found: $app_dir" >&2
    exit 1
fi

cd "$app_dir"
exec python3 -B -m configurator.config_store "$@"
